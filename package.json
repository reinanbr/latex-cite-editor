{
  "name": "latex-cite-editor",
  "version": "0.4.2",
  "description": "A CodeMirror 6 based React editor with LaTeX-style \\cite{} bibliography autocomplete backed by BibTeX (.bib) files",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "docs:dev": "vite --config docs-src/vite.config.ts",
    "docs:build": "vite build --config docs-src/vite.config.ts"
  },
  "keywords": [
    "react",
    "nextjs",
    "codemirror",
    "latex",
    "bibtex",
    "citation",
    "bibliography",
    "markdown",
    "editor",
    "autocomplete",
    "abnt",
    "ieee",
    "mla",
    "apa",
    "endnote",
    "refworks"
  ],
  "author": "ReinanBr",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.1"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8.3.5",
    "typescript": "^5.8.2",
    "vite": "^6.4.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/reinanbr/latex-cite-editor"
  }
}
